# Copy to .env at the repository root and edit for your machine or cluster.
#   cp .env.example .env
# .env is gitignored, so nothing here ever leaves your machine.
#
# Read by paths.py (Python side) and sourced by the scripts in experiments/jobs/
# (shell side). Real environment variables take precedence over this file.

# ── Data ────────────────────────────────────────────────────────────────────
# Directory holding the NSynth splits: training/ validation/ test/
# Point it anywhere — a scratch filesystem, an external drive, a shared mount.
# Leave blank to use ./data/nsynth inside the repository.
NSYNTH_DIR=

# ── Environment ─────────────────────────────────────────────────────────────
# Pixi environment used by the job wrappers. Training and evaluation need CUDA.
SM_PIXI_ENV=cuda

# ── Weights & Biases (optional) ─────────────────────────────────────────────
# offline: train with no account at all; nothing is uploaded anywhere.
# online:  fill in your own key and entity to log to your workspace.
WANDB_MODE=offline
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=DAFx26-Karplus

# ── SLURM site ──────────────────────────────────────────────────────────────
# Leave anything your cluster does not use blank; blank values are not passed
# to sbatch at all.
SM_SLURM_ACCOUNT=
SM_SLURM_PARTITION=
SM_SLURM_QOS=

# GPU request style varies by site. Most clusters use GRES; some newer ones
# prefer --gpus, in which case set SM_SLURM_GRES= and SM_SLURM_GPUS=1.
SM_SLURM_GRES=gpu:1
SM_SLURM_GPUS=

# Node selection, if your site needs it (e.g. SM_SLURM_CONSTRAINT=a100).
SM_SLURM_NODES=
SM_SLURM_CONSTRAINT=

SM_SLURM_NTASKS=1
SM_SLURM_CPUS_PER_TASK=4

SM_SLURM_TRAIN_MEM=32G
SM_SLURM_TRAIN_TIME=24:00:00
SM_SLURM_TRAIN_SIGNAL=B:TERM@300

SM_SLURM_EVAL_MEM=64G
SM_SLURM_EVAL_TIME=6:00:00

# Shell run inside the job before python starts — module loads, site setup.
# Semicolon-separated, quoted:
#   SM_SLURM_PREAMBLE='module load cuda/12.9; module load gcc/11'
SM_SLURM_PREAMBLE=

# Node-local scratch for the pixi package cache. Using node-local storage
# avoids incomplete rattler cache extraction on shared filesystems.
SM_SCRATCH_DIR=/tmp

# Any further sbatch flags. Split on spaces, so avoid quoted arguments here.
SM_SLURM_TRAIN_EXTRA_ARGS=
SM_SLURM_EVAL_EXTRA_ARGS=
