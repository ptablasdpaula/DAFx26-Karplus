# Local configuration — cluster settings, dataset location, W&B key.
.env

# Pixi
.pixi/*
!.pixi/config.toml

# Python
__pycache__/
*.py[cod]

# Fetched artifacts. Checkpoints come from the `checkpoints` branch via
# scripts/fetch_checkpoints.sh; evaluation audio is rendered by evaluate.py.
experiments/checkpoints/
experiments/evaluation/audio/

# Run outputs
experiments/outputs/
experiments/logs/
experiments/wandb/
wandb/
logs/

# NSynth lives wherever NSYNTH_DIR points; these are the in-repo default.
data/nsynth/test/
data/nsynth/validation/
data/nsynth/training/
data/nsynth/*.tar.gz
data/nsynth/loudness_stats.json

# Regenerated by the notebooks
figures/*.pdf
figures/*.png
experiments/gradient_accuracy_*.csv

# Editors / OS
.idea/
.vscode/
.DS_Store
