# Copy this file to experiments/jobs/.env and edit it for your machine or cluster.
# The .env file is ignored by git.

# Pixi environment used by run_training.sh and run_evaluation.sh. The training
# and evaluation scripts require a visible CUDA GPU.
SM_PIXI_ENV=cuda

# Optional SLURM site settings. Leave blank if your cluster does not need them.
SM_SLURM_ACCOUNT=
SM_SLURM_PARTITION=
SM_SLURM_QOS=

# GPU request style varies by cluster. Most older clusters use GRES. Some newer
# clusters prefer --gpus instead; if so, set SM_SLURM_GRES= and SM_SLURM_GPUS=1.
SM_SLURM_GRES=gpu:1
SM_SLURM_GPUS=

SM_SLURM_NTASKS=1
SM_SLURM_CPUS_PER_TASK=4

SM_SLURM_TRAIN_MEM=32G
SM_SLURM_TRAIN_TIME=24:00:00
SM_SLURM_TRAIN_SIGNAL=B:TERM@300

SM_SLURM_EVAL_MEM=64G
SM_SLURM_EVAL_TIME=6:00:00

# Extra options are split on spaces, so avoid quoted arguments here.
SM_SLURM_TRAIN_EXTRA_ARGS=
SM_SLURM_EVAL_EXTRA_ARGS=
